# =====================================================================
# GROQ API KEY CONFIGURATION (Dual-Key Setup to Avoid Rate Limits)
# =====================================================================
# Key 1: Ticket Agent (Document Processing Pipeline for Civic Tickets)
GROQ_API_KEY=your-groq-api-key-for-tickets
TICKET_AGENT_GROQ_KEY=your-groq-api-key-for-tickets

# Key 2: Testing Agent (Autonomous Prompt Healing, Assertions & Regression Tests)
# Dedicated quota for testing agent to prevent hitting rate limits
TESTING_AGENT_GROQ_KEY=your-groq-api-key-for-testing

# LLM Model (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
